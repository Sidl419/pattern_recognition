{
  "name": "samara_pz_svm_sc_n1",
  "seed": 0,
  "device": "auto",
  "split": {
    "seed": 0,
    "epoch_holdout": 0.3,
    "stratify": true,
    "val_fraction": 0.2
  },
  "data": {
    "pipeline": "SamaraWithinSubjectAverage",
    "params": {
      "path": "Samara_data/",
      "channel_idx": 1,
      "n_average": 1,
      "mode": "SC"
    }
  },
  "model": {
    "name": "SVM",
    "params": {
      "C": 1.0,
      "kernel": "rbf",
      "probability": true
    }
  },
  "train": {
    "lr": 0.0001,
    "weight_decay": 0.01,
    "batch_size": 64,
    "num_epochs": 1,
    "step_size": 1,
    "gamma": 1.0,
    "save_model": true
  },
  "output_dir": "results/"
}
